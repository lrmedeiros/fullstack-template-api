# Copie para .env:  cp .env.example .env
NODE_ENV=development
PORT=3001

# Postgres do docker-compose (porta 5432 exposta no host)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-with-32-plus-chars
JWT_EXPIRES_IN=1h

# Origem liberada no CORS e destino do redirect do OAuth
WEB_URL=http://localhost:3000

# OAuth2 com Google (opcional). Sem estas variáveis, /api/auth/google responde 501.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
